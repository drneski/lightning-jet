# Lightning Jet 2.0, read-only and in shadow mode, under systemd.
#
# Jet runs as a fresh unprivileged user, sees a read-only file system apart
# from its own state directory, and can reach only this machine. Home
# directories are inaccessible. The drop-in in jet.service.d/ binds LND's
# tls.cert and readonly.macaroon into /run/lightning-jet, read-only, and
# nothing else of LND's. See README.md.

[Unit]
Description=Lightning Jet 2.0 (read-only, shadow mode)
Documentation=https://github.com/drneski/lightning-jet/tree/v2
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
# The LND paths are where the drop-in binds the two files, so they override
# any in jet.conf.
ExecStart=/opt/lightning-jet/jet run --config /etc/lightning-jet/jet.conf --data-dir /var/lib/lightning-jet --tls-cert /run/lightning-jet/tls.cert --macaroon /run/lightning-jet/readonly.macaroon
Restart=on-failure
RestartSec=30s
TimeoutStopSec=60s
# Jet pings the watchdog every 10 minutes while healthy. If a cycle hangs, the
# pings stop and systemd restarts it.
WatchdogSec=20min

# Identity and files.
DynamicUser=yes
StateDirectory=lightning-jet
StateDirectoryMode=0700
ConfigurationDirectory=lightning-jet
# Where the drop-in binds LND's files. It exists before the bind mounts are
# made, so systemd needn't create directories for them, which under UMask=0077
# Jet couldn't enter.
RuntimeDirectory=lightning-jet
RuntimeDirectoryMode=0700
UMask=0077
ProtectSystem=strict
# Not tmpfs: with ProtectSystem=strict, systemd 241 (Debian 10, Umbrel) drops
# ProtectHome=tmpfs and leaves the real /home visible.
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Network: LND on this machine only, and systemd's notify socket. The address
# allowlist needs a kernel with cgroup BPF; without it, systemd warns and runs
# without the allowlist (as on the Raspberry Pi kernel of Umbrel's Debian 10),
# and the only guard is that Jet's code makes no outbound connections.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Privileges.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
